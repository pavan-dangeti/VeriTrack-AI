# ---- Environment ----
# development | production. Production refuses insecure defaults (JWT key, CORS).
ENVIRONMENT=development

# ---- Database ----
# postgres://… URLs from hosting providers are accepted as-is.
DATABASE_URL=postgresql+asyncpg://veritrack:veritrack@localhost:5432/veritrack
TEST_DATABASE_URL=postgresql+asyncpg://veritrack:veritrack@localhost:5432/veritrack_test
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---- Auth / JWT ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=dev-only-secret-change-me-min-32-characters-long
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12
LOCKOUT_THRESHOLD=5
LOCKOUT_DURATION_MINUTES=15
# strict when the UI and API share an origin (Vercel rewrite / nginx);
# none only if the UI calls the API cross-site (requires HTTPS)
COOKIE_SAMESITE=strict
# proxies in front of the API: 0 direct, 1 Render or nginx, 2 Vercel rewrite → Render
TRUSTED_PROXY_HOPS=1

# ---- CORS (explicit origins only, comma-separated) ----
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ---- Processing ----
# background (default, no Redis) | celery (Redis + workers) | inline (tests)
PROCESSING_MODE=background
OCR_ENGINE=auto
OCR_CONCURRENCY=2
MAX_FILE_SIZE_MB=25
MAX_FILES_PER_BATCH=20

# ---- Storage ----
# local (dev) | volume (persistent disk, allowed in production) | s3
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./storage-data
# S3-compatible alternative:
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=
# S3_BUCKET=veritrack
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ---- Rate limits: memory:// for one API instance, redis://… for several ----
RATE_LIMIT_STORAGE_URI=memory://

# ---- Celery (PROCESSING_MODE=celery only) ----
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---- Microsoft Entra ID SSO (leave empty to disable) ----
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_TENANT_ID=common
M365_REDIRECT_URI=http://localhost:8000/api/v1/auth/m365/callback

# ---- Outbound email via Microsoft Graph (dry_run records, never sends) ----
OUTBOUND_EMAIL_MODE=dry_run
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_MAILBOX=

# ---- Bootstrap: the only seeded account ----
SEED_ADMIN_EMAIL=admin@veritrack.io
# SEED_ADMIN_PASSWORD=

# ---- Environment ----
# development | production. In production, JWT_SECRET_KEY MUST be set explicitly.
ENVIRONMENT=development

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://veritrack:veritrack@localhost:5432/veritrack

# Used by tests only. Test DB is created/truncated automatically.
TEST_DATABASE_URL=postgresql+asyncpg://veritrack:veritrack@localhost:5432/veritrack_test

# ---- Auth / JWT ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=dev-only-secret-change-me-min-32-characters-long
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# Account lockout: N failed attempts within the window locks the account
LOCKOUT_THRESHOLD=5
LOCKOUT_WINDOW_MINUTES=15
LOCKOUT_DURATION_MINUTES=15

# ---- CORS (explicit origins only, comma-separated) ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Microsoft Entra ID (Azure AD) ----
# Leave empty to disable M365 SSO endpoints (password auth keeps working)
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_TENANT_ID=common
M365_REDIRECT_URI=http://localhost:8000/api/v1/auth/m365/callback

# ---- Bootstrap CLI ----
SEED_ADMIN_EMAIL=admin@veritrack.io
SEED_ADMIN_PASSWORD=Bootstrap!Pass123

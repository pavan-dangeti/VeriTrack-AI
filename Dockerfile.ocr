# Production sidecar for full PaddleOCR + Table Transformer.
# Paddle publishes wheels for py3.9-3.12 on linux — NOT py3.14/macOS, hence
# the pinned version. The main API keeps its own Python; they share only
# Postgres + Redis (this image can also run as a Celery worker).
FROM python:3.12-slim

WORKDIR /srv
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 libgomp1 && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt paddlepaddle==3.0.0 \
    "paddleocr>=2.7" "transformers>=4.40" torch --index-url https://pypi.org/simple

COPY alembic.ini ./
COPY alembic ./alembic
COPY app ./app

# Either: celery -A app.worker worker --loglevel=INFO
# Or:     uvicorn app.main:app --host 0.0.0.0 (as an OCR microservice)
CMD ["celery", "-A", "app.worker", "worker", "--loglevel=INFO", "-Q", "ocr"]
